# ============================================================
# CAM1 - Sistema automatico de playlist M3U do CAM4
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA commite o arquivo .env no repositorio.
# ============================================================

# ---------- GitHub (publicacao) ----------
# Token de acesso pessoal (fine-grained) com permissao minima:
#   Repository access: apenas "cam1-playlist"
#   Permissions -> Contents: "Read and write"
# Crie em: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Repositorio, branch e caminho do arquivo publicado
GITHUB_REPO=leandrorsnrz/cam1-playlist
GITHUB_BRANCH=main
GITHUB_FILE_PATH=cam1.m3u

# ---------- Descoberta de transmissoes (CAM4) ----------
# Generos consultados, separados por virgula.
# Validos: female, male, transgender
CAM4_GENDERS=female,male,transgender
# Salas por pagina na API GraphQL (maximo 300)
CAM4_PAGE_SIZE=100
# Limite de paginas por genero (protecao contra loop)
CAM4_MAX_PAGES=25
# Limite total de salas na playlist (0 = sem limite)
CAM4_MAX_ROOMS=0
# Incluir salas em show privado (PRIVATE_SHOW)? true/false
CAM4_INCLUDE_PRIVATE=false

# ---------- Validacao dos links HLS ----------
VALIDATE_LINKS=true
# Conexoes simultaneas na validacao
VALIDATE_CONCURRENCY=8
# Timeout de cada requisicao de validacao (ms)
VALIDATE_TIMEOUT_MS=15000

# ---------- Automacao continua ----------
# Intervalo entre ciclos automaticos, em minutos
UPDATE_INTERVAL_MINUTES=15
# Backoff progressivo apos falhas (segundos)
RETRY_BASE_SECONDS=30
RETRY_MAX_SECONDS=1800

# ---------- Servidor da interface ----------
PORT=3333
LOG_LEVEL=info
